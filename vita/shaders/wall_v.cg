// Walls: the facade pictures, tinted by the building's own colour and lit.

void main(
    float3 aPosition,
    float2 aAo,
    float3 aNormal,
    float aLate,
    float4 aColor,
    float2 aUv,
    uniform float4x4 uMvp,
    uniform float4 uMap,
    uniform float4 uFrame[4],
    out float4 oPosition : POSITION,
    out float2 oUv : TEXCOORD0,
    out float2 oMap : TEXCOORD1,
    out float2 oHeight : TEXCOORD2,
    out float4 oLight : COLOR0,
    out float4 oTint : COLOR1)
{
    oPosition = mul(uMvp, float4(aPosition, 1.0));
    // The height grid is read a little way out from the wall: under it lies the building's own roof.
    oUv = float2(aUv.x, aUv.y * FACADE_V);
    oMap = (aPosition.xz + aNormal.xz * WALL_OUT) * uMap.xy + uMap.zw;
    // Each building's rooms come on at their own moment of the dusk; y: how bright they are then.
    oHeight = float2(aPosition.y, saturate((uFrame[1].w - aLate * 0.6) * 4.0) * aAo.y * 2.0);
    oLight = float4((uFrame[1].rgb + uFrame[2].rgb * aNormal.y) * aAo.x, max(dot(aNormal, uFrame[0].xyz), 0.0));
    oTint = float4(aColor.rgb, haze_of(oPosition.w, uFrame));
}
