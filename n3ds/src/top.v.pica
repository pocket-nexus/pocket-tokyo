; The ground and the roofs. A vertex is its place over a block and how much of
; the sky it sees; the picture's coordinates, and those of the lamps' light and
; of the shadows (one grid over the whole city), come from the place itself.
.fvec mvp[4]
; u = x * pic.x + pic.y, v = z * pic.z + pic.w
.fvec pic
.fvec map
; rgb: the light on what looks up, halved; w: 1 / 255
.fvec light
.constf consts(0.0, 1.0, 0.0, 1.0)
.in inpos v0
.in inao v1
.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.entry main
.proc main
    mov r0.xyz, inpos.xyz
    mov r0.w, consts.w
    dp4 outpos.x, mvp[0], r0
    dp4 outpos.y, mvp[1], r0
    dp4 outpos.z, mvp[2], r0
    dp4 outpos.w, mvp[3], r0
    mul r1.xy, pic.xz, inpos.xz
    add r1.xy, pic.yw, r1.xy
    ; (a source's swizzle is applied before the write mask picks components: one component at a time)
    mov r1.z, consts.x
    mov r1.w, consts.w
    mov outtc0, r1
    mul r2.xy, map.xz, inpos.xz
    add r2.xy, map.yw, r2.xy
    mov r2.z, consts.x
    mov r2.w, consts.w
    mov outtc1, r2
    mov outtc2, r2
    mul r3, light.wwww, inao.xxxx
    mul r3.xyz, light.xyz, r3.xyz
    mov r3.w, consts.w
    mov outclr, r3
    end
.end
